#!/bin/bash
# Omni36OS nos clones: nos 3 primeiros minutos de cada boot grava em /boot/omni36os-diag.txt
# (partição BOOT, lida no PC) o que o systemd ainda espera e o que falhou. Se o boot travar,
# o arquivo mostra onde.
OUT=/boot/omni36os-diag.txt
for _ in $(seq 36); do
  {
    echo "== $(date '+%d/%m/%Y %H:%M:%S') uptime $(cut -d' ' -f1 /proc/uptime)s"
    systemctl is-system-running 2>&1
    echo "-- esperando"; systemctl list-jobs --no-pager 2>&1 | head -40
    echo "-- falharam"; systemctl --failed --no-pager --plain 2>&1 | head -20
    echo "-- tela"; for f in modes stride bits_per_pixel; do echo "$f: $(cat /sys/class/graphics/fb0/$f 2>/dev/null)"; done
    echo "-- kernel"; dmesg 2>/dev/null | tail -40
  } > "$OUT.tmp" 2>&1
  mv "$OUT.tmp" "$OUT"
  sync
  sleep 5
done
